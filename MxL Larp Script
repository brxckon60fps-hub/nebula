---------------- Method 1: hook the Prompt* calls (needs hookmetamethod; skipped if missing)
local PROMPTS = {
    PromptPurchase = Enum.InfoType.Asset, PromptProductPurchase = Enum.InfoType.Product,
    PromptGamePassPurchase = Enum.InfoType.GamePass, PromptBundlePurchase = Enum.InfoType.Bundle,
}

local function installHook()
    if hookInstalled then return true end
    if not (hookmetamethod and getnamecallmethod) then return false end
    local ok = pcall(function()
        local old
        local function handler(self, ...)
            local method = getnamecallmethod()
            if interceptOn and self == MarketplaceService and PROMPTS[method] then
                local id = select(2, ...)
                local infoType = PROMPTS[method]
                task.spawn(function()
                    local name, price, icon = "Item", 100, nil
                    local ok2, info = pcall(function() return MarketplaceService:GetProductInfo(id, infoType) end)
                    if ok2 and type(info) == "table" then
                        name = info.Name or name
                        price = info.PriceInRobux or info.Price or price
                        if info.IconImageAssetId and info.IconImageAssetId ~= 0 then icon = "rbxassetid://" .. info.IconImageAssetId end
                    end
                    showPrompt(name, price, icon)
                end)
                return
            end
            return old(self, ...)
        end
        old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(handler) or handler)
    end)
    hookInstalled = ok
    return ok
end

---------------- Method 2 + 3: catch the real prompt / shop clicks
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local logFn = function() end
local coreConn, shopConn, realRoot, realHide = nil, nil, nil, nil
local disabledConns = {}

local function isOwn(obj)
    for _, g in ipairs(ownGuis) do if obj:IsDescendantOf(g) then return true end end
    return false
end
local function textOf(d) return (tostring(d.Text):gsub("<[^>]+>", "")) end
local function hasWord(s, w) return s:lower():find("%f[%a]" .. w .. "%f[%A]") ~= nil end

local function isPromptText(t)
    t = t:lower()
    for _, k in ipairs({ "terms of use", "payment method", "buy robux", "buy item", "buy now", "get 10% off" }) do
        if t:find(k, 1, true) then return true end
    end
    return false
end

local function parsePrice(t)
    if #t > 24 then return nil end
    local n = t:match("([%d,]+)%s*[Rr][Oo][Bb][Uu][Xx]") or t:match("^%s*R%$%s*([%d,]+)%s*$") or t:match("^%s*([%d,]+)%s*R%$%s*$")
    return n and tonumber((n:gsub(",", "")))
end

local function scrapeRealPrompt(root)
    local name, nameY, icon, nums = nil, 0, nil, {}
    for _, d in ipairs(root:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
            local t = textOf(d)
            if t:match("^[%d,%.]+$") then
                table.insert(nums, d)
            else
                local l = t:lower()
                local skip = l:find("buy", 1, true) or l:find("robux", 1, true) or l:find("terms", 1, true)
                    or l:find("payment", 1, true) or l:find("cancel", 1, true) or l:find("$", 1, true) or hasWord(l, "off")
                if not skip and (not name or #t > #name) then name, nameY = t, d.AbsolutePosition.Y end
            end
        elseif (d:IsA("ImageLabel") or d:IsA("ImageButton")) and not icon and d.Image ~= "" and d.AbsoluteSize.X >= 56 then
            icon = d.Image
        end
    end
    local price, best = 100, math.huge
    for _, d in ipairs(nums) do
        local dy = d.AbsolutePosition.Y - nameY
        if dy > 0 and dy < best then best = dy; price = tonumber((d.Text:gsub(",", ""))) or price end
    end
    return name or "Item", price, icon
end

-- only ever presses Cancel/Close on the real prompt, never Buy
local function tryCancelReal(root)
    if not getconnections then return false end
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            local t = d:IsA("TextButton") and d.Text:lower() or ""
            local n = d.Name:lower()
            if (t == "cancel" or n:find("cancel") or n:find("close")) and not t:find("buy") and not n:find("buy") then
                local fired = false
                pcall(function()
                    for _, c in ipairs(getconnections(d.Activated)) do c:Fire(); fired = true end
                    for _, c in ipairs(getconnections(d.MouseButton1Click)) do c:Fire(); fired = true end
                end)
                if fired then return true end
            end
        end
    end
    return false
end

local function promptRootFor(d)
    local sg = d:FindFirstAncestorOfClass("ScreenGui")
    if not sg then return nil end
    if sg.Name ~= "RobloxGui" then return sg end
    local top = d
    while top.Parent and top.Parent ~= sg do top = top.Parent end
    return top
end

local function hideReal(root)
    local prop = root:IsA("ScreenGui") and "Enabled" or "Visible"
    pcall(function() root[prop] = false end)
    realHide = { obj = root, prop = prop }
end
local function unhideReal()
    if realHide then pcall(function() realHide.obj[realHide.prop] = true end) end
    realHide = nil
end
local function realStillThere()
    if not realRoot or not realRoot.Parent then return false end
    for _, d in ipairs(realRoot:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and isPromptText(textOf(d)) then return true end
    end
    return false
end

local function handleReal(d)
    if flagged or not interceptOn then return end
    local root = promptRootFor(d)
    if not root then return end
    flagged, realRoot = true, root
    task.wait(0.25)                                   -- let Roblox finish building the prompt
    local name, price, icon = scrapeRealPrompt(root)
    logFn("Caught Roblox prompt: " .. name .. " (" .. price .. ")")
    hideReal(root)
    showPrompt(name, price, icon, function()
        if not tryCancelReal(root) then unhideReal() end
    end)
end

local function checkObj(d)
    if not interceptOn or flagged then return end
    if not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
    if isOwn(d) then return end
    if isPromptText(textOf(d)) then task.spawn(handleReal, d) end
end

-- shop clicks: look at what is under the cursor when you press, e.g. a "245 Robux" button
local function findShopInfo(priceObj)
    local anc = priceObj.Parent
    for _ = 1, 4 do
        if not anc or anc:IsA("LayerCollector") then break end
        local nameLbl, bestSize, icon = nil, 0, nil
        for _, d in ipairs(anc:GetDescendants()) do
            if d ~= priceObj and (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
                local t = textOf(d)
                local size = d.TextScaled and d.AbsoluteSize.Y or d.TextSize
                if not parsePrice(t) and #t >= 3 and not t:match("^[%d,%.%s]+$")
                    and not t:find("^%s*\226\128\162") and not t:find("^%s*\194\183")
                    and d.AbsolutePosition.Y < priceObj.AbsolutePosition.Y and size > bestSize then
                    nameLbl, bestSize = d, size
                end
            elseif (d:IsA("ImageLabel") or d:IsA("ImageButton")) and not icon and d.Image ~= "" then
                icon = d.Image
            end
        end
        if nameLbl then return textOf(nameLbl), icon end
        anc = anc.Parent
    end
    return "Item", nil
end

local function onShopPress(input)
    if not interceptOn then return end
    local kind = input.UserInputType
    if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
    local pg = lp:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    local pos
    if kind == Enum.UserInputType.Touch then
        pos = Vector2.new(input.Position.X, input.Position.Y)
    else
        pos = UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
    end
    local objs = pg:GetGuiObjectsAtPosition(pos.X, pos.Y)
    local priceObj, price
    for _, o in ipairs(objs) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and not isOwn(o) then
            local p = parsePrice(textOf(o))
            if p then priceObj, price = o, p; break end
        end
    end
    if not priceObj then return end
    if getconnections then      -- stop the game's own handlers so the real prompt never opens
        pcall(function()
            for _, o in ipairs(objs) do
                if o:IsA("GuiButton") and not isOwn(o) then
                    for _, sig in ipairs({ o.Activated, o.MouseButton1Click, o.MouseButton1Down, o.MouseButton1Up }) do
                        for _, c in ipairs(getconnections(sig)) do c:Disable(); table.insert(disabledConns, c) end
                    end
                end
            end
        end)
    end
    local name, icon = findShopInfo(priceObj)
    logFn("Caught shop click: " .. name .. " (" .. price .. ")")
    showPrompt(name, price, icon)
    task.delay(1, function()
        for _, c in ipairs(disabledConns) do pcall(function() c:Enable() end) end
        disabledConns = {}
    end)
end

local function startIntercept()
    installHook()
    if not coreConn then
        pcall(function() coreConn = CoreGui.DescendantAdded:Connect(checkObj) end)
    end
    if not shopConn then shopConn = UserInputService.InputBegan:Connect(onShopPress) end
    if watchThread then return end
    watchThread = task.spawn(function()
        while interceptOn do
            if not flagged then
                local app = CoreGui:FindFirstChild("PurchasePromptApp")
                if app then
                    for _, d in ipairs(app:GetDescendants()) do
                        if (d:IsA("TextLabel") or d:IsA("TextButton")) and isPromptText(textOf(d)) then
                            task.spawn(handleReal, d)
                            break
                        end
                    end
                end
            elseif not realStillThere() then
                flagged = false
                unhideReal()
            end
            task.wait(0.25)
        end
        if shopConn then shopConn:Disconnect(); shopConn = nil end
        if coreConn then coreConn:Disconnect(); coreConn = nil end
        for _, c in ipairs(disabledConns) do pcall(function() c:Enable() end) end
        disabledConns = {}
        unhideReal()
        flagged = false
        watchThread = nil
    end)
end

