----------------------------------------------------------------  Name / username / badge engine
local realName, realDisplay = lp.Name, lp.DisplayName
local state = { display = nil, user = nil, badge = false }
local tracked, watched, ownGuis = {}, {}, {}

local function esc(s) return (s:gsub("%p", "%%%0")) end
local function repl(s) return (s:gsub("%%", "%%%%")) end

local function displayTarget() return (state.display or realDisplay) .. (state.badge and BADGE or "") end

-- list of { n = original, t = replacement, m = marker }
-- "@name" is treated as the username; plain name text is the display name
local function getMaps()
    local maps = {}
    local dt = displayTarget()
    if dt ~= realDisplay then table.insert(maps, { n = realDisplay, t = dt, m = "\1" }) end
    if state.user and state.user ~= realName then
        table.insert(maps, { n = "@" .. realName, t = "@" .. state.user, m = "\2" })
        if realName ~= realDisplay then table.insert(maps, { n = realName, t = state.user, m = "\3" }) end
    elseif dt ~= realDisplay and realName == realDisplay then
        table.insert(maps, { n = "@" .. realName, t = "@" .. realName, m = "\2" })   -- keep @username untouched
    end
    return maps
end

local function process(obj)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
    local maps = getMaps()
    if #maps == 0 then return end
    for _, g in ipairs(ownGuis) do if obj:IsDescendantOf(g) then return end end
    local s = obj.Text
    local out = s
    table.sort(maps, function(a, b) return #a.t > #b.t end)
    for _, m in ipairs(maps) do out = out:gsub(esc(m.t), m.m) end       -- already converted
    table.sort(maps, function(a, b) return #a.n > #b.n end)
    for _, m in ipairs(maps) do out = out:gsub(esc(m.n), m.m) end       -- still original
    for _, m in ipairs(maps) do out = out:gsub(m.m, repl(m.t)) end
    if out ~= s then tracked[obj] = true; obj.Text = out end
end

local function watch(d)
    if watched[d] or not (d:IsA("TextLabel") or d:IsA("TextButton")) then return end
    watched[d] = true
    d:GetPropertyChangedSignal("Text"):Connect(function() process(d) end)
end

local function roots()
    local r = { lp:FindFirstChildOfClass("PlayerGui") }
    pcall(function() table.insert(r, CoreGui) end)
    return r
end

local function applyHumanoid(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.DisplayName = displayTarget() end
end

local function setState(display, user, badge)
    local old = getMaps()
    state.display, state.user, state.badge = display, user, badge
    for obj in pairs(tracked) do
        if obj.Parent then
            local t = obj.Text
            for _, m in ipairs(old) do t = t:gsub(esc(m.t), repl(m.n)) end
            obj.Text = t
        end
    end
    tracked = {}
    applyHumanoid(lp.Character)
    for _, r in ipairs(roots()) do
        for _, d in ipairs(r:GetDescendants()) do watch(d); process(d) end
    end
end

local hooked = false
local function startHooks()
    if hooked then return end
    hooked = true
    for _, r in ipairs(roots()) do
        r.DescendantAdded:Connect(function(d) task.defer(function() watch(d); process(d) end) end)
    end
    lp.CharacterAdded:Connect(function(c) c:WaitForChild("Humanoid"); applyHumanoid(c) end)
end

----------------------------------------------------------------  Avatar morph (clothes, body colors, hair, accessories, face)
local function loadObj(id)
    local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
    if ok and type(res) == "table" and res[1] then return res[1] end
    local ok2, m = pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
    if ok2 and m then return m end
    return nil
end

local function pick(obj, class)
    if not obj then return nil end
    if obj:IsA(class) then return obj end
    return obj:FindFirstChildWhichIsA(class, true)
end

local function accessoryIds(desc)
    local ids = {}
    local ok, list = pcall(function() return desc:GetAccessories(true) end)
    if ok and type(list) == "table" and #list > 0 then
        for _, a in ipairs(list) do
            if a.AssetId and a.AssetId ~= 0 then table.insert(ids, a.AssetId) end
        end
        return ids
    end
    for _, prop in ipairs({ "HatAccessory", "HairAccessory", "FaceAccessory", "NeckAccessory",
        "ShouldersAccessory", "FrontAccessory", "BackAccessory", "WaistAccessory" }) do
        for n in tostring(desc[prop] or ""):gmatch("%d+") do
            if tonumber(n) ~= 0 then table.insert(ids, tonumber(n)) end
        end
    end
    return ids
end

local function morphToId(id, log)
    log = log or function() end
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false, "No character found" end

    local okD, desc = pcall(Players.GetHumanoidDescriptionFromUserId, Players, id)
    if not okD or not desc then return false, "Couldn't read that player's avatar" end

    local parts = {}

    -- body colors + clothes
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") then v:Destroy() end
    end
    new("BodyColors", {
        HeadColor3 = desc.HeadColor, TorsoColor3 = desc.TorsoColor, LeftArmColor3 = desc.LeftArmColor,
        RightArmColor3 = desc.RightArmColor, LeftLegColor3 = desc.LeftLegColor, RightLegColor3 = desc.RightLegColor,
        Parent = char,
    })
    local clothes = 0
    for _, spec in ipairs({ { desc.Shirt, "Shirt" }, { desc.Pants, "Pants" }, { desc.GraphicTShirt, "ShirtGraphic" } }) do
        if spec[1] and spec[1] ~= 0 then
            log("Loading " .. spec[2] .. "...")
            local c = pick(loadObj(spec[1]), spec[2])
            if c then c:Clone().Parent = char; clothes += 1 end
        end
    end
    table.insert(parts, clothes .. " clothing")

    -- hair + accessories
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") then v:Destroy() end
    end
    local ids, added = accessoryIds(desc), 0
    for i, aid in ipairs(ids) do
        log("Loading accessory " .. i .. "/" .. #ids .. "...")
        local acc = pick(loadObj(aid), "Accessory")
        if acc and pcall(function() hum:AddAccessory(acc:Clone()) end) then added += 1 end
    end
    table.insert(parts, added .. "/" .. #ids .. " accessories")

    -- face
    local head = char:FindFirstChild("Head")
    if head and desc.Face and desc.Face ~= 0 then
        local d = pick(loadObj(desc.Face), "Decal")
        if d then
            local face = head:FindFirstChildOfClass("Decal") or new("Decal", { Name = "face", Face = Enum.NormalId.Front, Parent = head })
            face.Texture = d.Texture
            table.insert(parts, "face")
        end
    end

    if clothes == 0 and added == 0 then
        if pcall(function() hum:ApplyDescription(desc) end) then return true, "applied with Roblox's built-in method" end
        return false, "Couldn't load avatar items (executor may lack GetObjects)"
    end
    return true, table.concat(parts, ", ")
end

local function morphToName(username, log)
    local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, username)
    if not ok then return false, "Player not found" end
    return morphToId(id, log)
end

